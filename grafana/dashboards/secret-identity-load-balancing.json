{
  "uid": "secret-identity-a3-lb",
  "title": "Secret Identity — Load Balancing (A/B/C + Envoy)",
  "description": "Per-replica request rate, share of total traffic, active requests, p50/p95 and errors for HTTP and gRPC, plus Envoy cluster stats. Rates use a 1m window; quantiles use a 5m window.",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "tags": ["secret-identity", "assignment3", "load-balancing", "envoy"],
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP: request rate per replica (req/s, 1m window)",
      "description": "sum by (replica) rate(http_requests_total[1m]) — scraped directly from each replica",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (replica) (rate(http_requests_total{job=\"secret-identity\", route!=\"/metrics\"}[1m]))",
          "legendFormat": "replica {{replica}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP: share of total traffic per replica (%, 1m window)",
      "description": "100 * replica rate / total rate. Compare with 33% each when round robin is on.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by (replica) (rate(http_requests_total{job=\"secret-identity\"}[1m])) / scalar(sum(rate(http_requests_total{job=\"secret-identity\"}[1m])))",
          "legendFormat": "{{replica}} share"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HTTP: active requests per replica",
      "description": "http_active_requests — requests currently being handled inside each replica",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (replica) (http_active_requests{job=\"secret-identity\"})",
          "legendFormat": "replica {{replica}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "HTTP: p50 / p95 per replica (s, 5m window)",
      "description": "histogram_quantile over http_request_duration_seconds_bucket, 5m rate window",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le, replica) (rate(http_request_duration_seconds_bucket{job=\"secret-identity\"}[5m])))",
          "legendFormat": "{{replica}} p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, replica) (rate(http_request_duration_seconds_bucket{job=\"secret-identity\"}[5m])))",
          "legendFormat": "{{replica}} p95"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "HTTP: errors by status per replica (errors/s, 1m window)",
      "description": "Non-2xx responses, split by replica and status code",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (replica, status_code) (rate(http_requests_total{job=\"secret-identity\", status_code!~\"2..\"}[1m]))",
          "legendFormat": "{{replica}} HTTP {{status_code}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "HTTP: replica share vs 33% (instant)",
      "description": "Current share of total HTTP traffic. Round robin should sit near 33.3% each.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 20 } ] } },
        "overrides": []
      },
      "options": { "displayMode": "lcd", "orientation": "horizontal" },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by (replica) (rate(http_requests_total{job=\"secret-identity\"}[1m])) / scalar(sum(rate(http_requests_total{job=\"secret-identity\"}[1m])))",
          "legendFormat": "{{replica}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "gRPC: call rate per replica (calls/s, 1m window)",
      "description": "sum by (replica) rate(grpc_server_handled_total[1m]) — scraped from each replica's :9091",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (replica) (rate(grpc_server_handled_total{job=\"secret-identity-grpc\"}[1m]))",
          "legendFormat": "replica {{replica}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "gRPC: share of total traffic per replica (%, 1m window)",
      "description": "With the HTTP/2 listener Envoy routes each call, so this should reach ~33% each under round robin.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by (replica) (rate(grpc_server_handled_total{job=\"secret-identity-grpc\"}[1m])) / scalar(sum(rate(grpc_server_handled_total{job=\"secret-identity-grpc\"}[1m])))",
          "legendFormat": "{{replica}} share"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "gRPC: active requests per replica",
      "description": "grpc_server_in_flight_requests — concurrent RPCs inside each replica",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (replica) (grpc_server_in_flight_requests{job=\"secret-identity-grpc\"})",
          "legendFormat": "replica {{replica}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "gRPC: p50 / p95 per replica (s, 5m window)",
      "description": "histogram_quantile over grpc_server_handling_seconds_bucket, 5m rate window",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le, replica) (rate(grpc_server_handling_seconds_bucket{job=\"secret-identity-grpc\"}[5m])))",
          "legendFormat": "{{replica}} p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, replica) (rate(grpc_server_handling_seconds_bucket{job=\"secret-identity-grpc\"}[5m])))",
          "legendFormat": "{{replica}} p95"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "gRPC: errors by status per replica (errors/s, 1m window)",
      "description": "Non-OK gRPC codes split by replica",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (replica, grpc_code) (rate(grpc_server_handled_total{job=\"secret-identity-grpc\", grpc_code!=\"OK\"}[1m]))",
          "legendFormat": "{{replica}} {{grpc_code}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Envoy: upstream requests per cluster (req/s, 1m window)",
      "description": "envoy_cluster_upstream_rq_total from Envoy's admin /stats/prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (envoy_cluster_name) (rate(envoy_cluster_upstream_rq_total{job=\"envoy\"}[1m]))",
          "legendFormat": "{{envoy_cluster_name}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Envoy: cluster health (healthy vs total members)",
      "description": "envoy_cluster_membership_healthy / _total. Drops when a replica is stopped and health checks remove it.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 48 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (envoy_cluster_name) (envoy_cluster_membership_healthy{job=\"envoy\"})",
          "legendFormat": "{{envoy_cluster_name}} healthy"
        },
        {
          "refId": "B",
          "expr": "sum by (envoy_cluster_name) (envoy_cluster_membership_total{job=\"envoy\"})",
          "legendFormat": "{{envoy_cluster_name}} total"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Envoy: upstream response code classes (req/s, 1m window)",
      "description": "envoy_cluster_upstream_rq_xx by response code class. Class 5 rises when traffic hits a dead replica without health checks.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 48 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (envoy_cluster_name, envoy_response_code_class) (rate(envoy_cluster_upstream_rq_xx{job=\"envoy\"}[1m]))",
          "legendFormat": "{{envoy_cluster_name}} class {{envoy_response_code_class}}"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Envoy: upstream connect failures & timeouts (1m window)",
      "description": "envoy_cluster_upstream_cx_connect_fail_total and envoy_cluster_upstream_rq_timeout",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 56 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (envoy_cluster_name) (rate(envoy_cluster_upstream_cx_connect_fail_total{job=\"envoy\"}[1m]))",
          "legendFormat": "{{envoy_cluster_name}} connect fail"
        },
        {
          "refId": "B",
          "expr": "sum by (envoy_cluster_name) (rate(envoy_cluster_upstream_rq_timeout{job=\"envoy\"}[1m]))",
          "legendFormat": "{{envoy_cluster_name}} rq timeout"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Envoy: active downstream connections (listener)",
      "description": "envoy_listener_downstream_cx_active — one long-lived connection for gRPC, many short ones for HTTP",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 56 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (envoy_listener_address) (envoy_listener_downstream_cx_active{job=\"envoy\"})",
          "legendFormat": "{{envoy_listener_address}}"
        }
      ]
    }
  ]
}
